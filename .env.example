# Copy to .env and adjust. .env is git-ignored.

# Camera: index (0, 1, ...) or a stream URL / video file / device path.
# Examples: CAMERA_SOURCE=1   CAMERA_SOURCE=http://192.168.1.20:8080/video
CAMERA_SOURCE=0

# Supabase (cloud sync of screenshots)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key
