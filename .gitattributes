# Normalize line endings: LF in the repo and in working trees on every OS,
# so the project behaves the same on Linux, macOS and Windows.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.task binary
*.tflite binary
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.mp3 binary
*.ogg binary
